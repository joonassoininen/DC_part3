
FROM node:16-alpine

WORKDIR /3_7

COPY code/example-frontend .

ENV REACT_APP_BACKEND_URL=http://localhost:8080

RUN npm install -g serve && adduser -D appuser && chown -R appuser . && \
    su appuser -c "npm install && npm run build && npm cache clean --force && rm -rf src node_modules" && \

USER appuser

EXPOSE 5001

CMD ["serve","-s","-l","5001", "build"]