FROM golang:1.16-alpine

WORKDIR /3_7

RUN adduser -D appuser && chown appuser /3_7

COPY --chown=appuser:appuser code/example-backend .

USER appuser

ENV CGO_ENABLED=0

RUN go build && go test ./... && go clean -cache -modcache

ENV REQUEST_ORIGIN=http://localhost:5001

EXPOSE 8080

CMD ["./server"]